{
  "name": "kernex-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "desktop:dev": "bun run --cwd crates/kernex-desktop tauri dev",
    "desktop:build": "bun run --cwd crates/kernex-desktop tauri build",
    "frontend:build": "bun run --cwd crates/kernex-desktop build",
    "frontend:typecheck": "bun run --cwd crates/kernex-desktop typecheck",
    "frontend:lint": "bun run --cwd crates/kernex-desktop lint",
    "frontend:test": "bun run --cwd crates/kernex-desktop test"
  }
}
